# App
APP_NAME=Local RAG System
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# LM Studio / OpenAI-compatible API
LLM_BASE_URL=http://10.0.0.79:4399/v1
LLM_MODEL=qwen/qwen3-v1-8b
LLM_API_KEY=lm-studio

# Cloud LLM (required only when LLM_PROVIDER=cloud)
LLM_PROVIDER=local
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_MODEL=deepseek-chat
CLOUD_LLM_API_KEY=

EMBEDDING_BASE_URL=http://10.0.0.79:4399/v1
EMBEDDING_MODEL=text-embedding-bge-small-zh-v1.5
EMBEDDING_API_KEY=lm-studio

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# LLM context window and server-side conversation memory
# Match LLM_CONTEXT_WINDOW to the active model/server context length.
LLM_CONTEXT_WINDOW=32768
LLM_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=512
# Offline-safe default; use a locally cached tiktoken encoding when appropriate.
CONTEXT_TOKENIZER_ENCODING=offline_multilingual
CONTEXT_ROUTING_OUTPUT_TOKENS=512
CONTEXT_ROUTING_HISTORY_MAX_TOKENS=4096
CONTEXT_HISTORY_MAX_TOKENS=8192
CONTEXT_DOCUMENT_MIN_TOKENS=4096
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MAX_TOKENS=1024
CONTEXT_SUMMARY_INPUT_TOKENS=6144
CONTEXT_SUMMARY_KEEP_RECENT_MESSAGES=12
CONTEXT_SUMMARY_BATCH_MESSAGES=8

# Rerank (optional)
RERANKER_TYPE=none
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_TOP_N=20
RERANKER_FINAL_TOP_K=5
RERANKER_MAX_CHARS=1500
RERANKER_DEVICE=cpu

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=local_rag_docs
