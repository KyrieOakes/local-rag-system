# App
APP_NAME=Local RAG System
APP_ENV=development
# Optional shared API key. Leave blank for trusted single-user local use.
APP_API_KEY=
# Used by `docker compose --profile full` to configure the browser client.
# When APP_API_KEY is enabled for that profile, set both values to the same
# local/shared-network passphrase. This value is visible in the browser bundle.
VITE_API_KEY=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://[::1]:5173"]
UPLOAD_MAX_BYTES=26214400
DEPENDENCY_CHECK_TIMEOUT_SECONDS=2
BACKGROUND_TASK_WORKERS=4
BACKGROUND_TASK_QUEUE_SIZE=256
SQLITE_BUSY_TIMEOUT_MS=5000

# LM Studio / OpenAI-compatible API
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen3-8b-mlx
LLM_API_KEY=lm-studio

# Cloud LLM (required only when LLM_PROVIDER=cloud)
LLM_PROVIDER=local
CLOUD_LLM_BASE_URL=https://api.deepseek.com
CLOUD_LLM_MODEL=deepseek-chat
CLOUD_LLM_API_KEY=

EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# Bump this label when weights/quantization change under the same model name.
EMBEDDING_REVISION=
EMBEDDING_API_KEY=lm-studio

# Used only by `docker compose --profile full`; containers cannot reach a
# host-local model server through 127.0.0.1.
DOCKER_LLM_BASE_URL=http://host.docker.internal:1234/v1
DOCKER_EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1

# RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5

# LLM context window and server-side conversation memory
# Match LLM_CONTEXT_WINDOW to the active model/server context length.
LLM_CONTEXT_WINDOW=32768
LLM_RESERVED_OUTPUT_TOKENS=2048
CONTEXT_SAFETY_MARGIN_TOKENS=512
# Offline-safe default; use a locally cached tiktoken encoding when appropriate.
CONTEXT_TOKENIZER_ENCODING=offline_multilingual
CONTEXT_ROUTING_OUTPUT_TOKENS=512
CONTEXT_ROUTING_HISTORY_MAX_TOKENS=4096
CONTEXT_HISTORY_MAX_TOKENS=8192
CONTEXT_DOCUMENT_MIN_TOKENS=4096
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MAX_TOKENS=1024
CONTEXT_SUMMARY_INPUT_TOKENS=6144
CONTEXT_SUMMARY_KEEP_RECENT_MESSAGES=12
CONTEXT_SUMMARY_BATCH_MESSAGES=8

# Rerank (optional)
RERANKER_TYPE=none
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATE_TOP_N=20
RERANKER_FINAL_TOP_K=5
RERANKER_MAX_CHARS=1500
RERANKER_DEVICE=cpu
RERANKER_TRUST_REMOTE_CODE=false

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=local_rag_docs
